---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import { loadDecklists } from '../utils/loadDecklists.js';
import { loadCardData } from '../utils/loadCardData.js';
import { getImageUrl, getImageSrcSet } from '../utils/helpers.js';
import { COLORS } from '../utils/cardConstants.js';

interface DeckCard {
  id: string; qty: number; name?: string; slug?: string; type?: string;
  color?: string; cost?: number | null; level?: number | null;
  ap?: number | null; hp?: number | null; rarity?: string;
  tcgPlayerId?: string | number; price?: number | null;
}
interface Deck {
  set: string; setName: string; sourceUrl: string;
  tournament: string; host: string; date: string;
  country: string; author: string; placement: string;
  deckColor: string; deckName: string; deckProfile: string;
  cardCount: number; uniqueCards: number;
  colors: string[]; cards: DeckCard[];
}

const { decks } = await loadDecklists() as
  { decks: Deck[]; fetchedAt: string | null; source: string | null };

// Full card pool â€” needed client-side so the TCGplayer Buy modal can
// cycle through alt-art printings. Stripped to the bare fields the
// modal renders, plus baseId for AA grouping.
const { cards: allCards } = await loadCardData() as { cards: any[] };
const cardPool = allCards.map(c => ({
  id: c.id,
  baseId: c.id?.split('_')[0],
  name: c.name,
  tcgPlayerId: c.tcgPlayerId || null,
  price: c.price ?? null,
}));

const totalDecks = decks.length;
// "Last refreshed" reflects the date of the most recent deck â€” the data
// we actually serve â€” rather than the scrape timestamp (which can refresh
// daily even when no new decks are published).
const lastDeckDate: string | null = decks
  .map(d => d.date)
  .filter((d): d is string => !!d)
  .sort()
  .pop() || null;
const description = totalDecks > 0
  ? `${totalDecks} tournament-winning Star Wars Unlimited decklists from competitive events. Browse top decks by color, see exact 50-card builds with prices.`
  : `Star Wars Unlimited tournament decklists. Pipeline pending, check back as new tournaments are reported.`;

const COLOR_HEX = Object.fromEntries(COLORS.map(c => [c.key, c.hex]));

function pairFill(parts: string[]): string {
  const c1 = COLOR_HEX[parts[0]] || '#888';
  if (parts.length < 2) return c1;
  const c2 = COLOR_HEX[parts[1]] || '#888';
  return `linear-gradient(90deg, ${c1}, ${c2})`;
}

// Top deck-name buckets for the Meta Snapshot (replaces color-pair grouping).
const deckNameCounts: Record<string, { count: number; colors: string[] }> = {};
for (const d of decks) {
  const key = (d.deckName || '').trim() || 'Unknown';
  if (!deckNameCounts[key]) deckNameCounts[key] = { count: 0, colors: d.colors || [] };
  deckNameCounts[key].count += 1;
}
const topDeckNames = Object.entries(deckNameCounts)
  .sort((a, b) => b[1].count - a[1].count)
  .slice(0, 10)
  .map(([name, info]) => ({ name, count: info.count, colors: info.colors }));

function formatDate(iso: string): string {
  if (!iso) return '';
  const [y, m] = iso.split('-');
  if (!y || !m) return iso;
  return `${m}/${y.slice(-2)}`;
}

function deckTotalPrice(cards: DeckCard[]): number {
  return cards.reduce((sum, c) => sum + (c.price ? Number(c.price) * c.qty : 0), 0);
}

function deckExportText(cards: DeckCard[]): string {
  return cards.map(c => `${c.qty} ${c.id}`).join('\n');
}

// Hero cards for the leftmost ViewDeck column. Pick the deck's most
// recognizable Units (Mobile Suits): rarest first, then most-played,
// then highest cost. Excluding Resources / Pilots / Commands / Bases
// keeps the strip focused on the iconic anime mecha so the same
// archetype renders the same image set every time.
const RARITY_ORDER = ['LR', 'SR', 'R', 'U', 'C', 'P'];
function pickHeroes(cards: DeckCard[], n = 2): DeckCard[] {
  return cards
    .filter(c => (c.type || '').toLowerCase() === 'unit')
    .sort((a, b) => {
      const ra = RARITY_ORDER.indexOf(a.rarity || 'C');
      const rb = RARITY_ORDER.indexOf(b.rarity || 'C');
      if (ra !== rb) return ra - rb;
      if ((b.qty || 0) !== (a.qty || 0)) return (b.qty || 0) - (a.qty || 0);
      return (b.cost ?? -1) - (a.cost ?? -1);
    })
    .slice(0, n);
}

// Group cards by type for the expanded view.
const TYPE_ORDER = ['Unit', 'Pilot', 'Command', 'Base', 'Resource'];
function groupByType(cards: DeckCard[]) {
  const buckets: Record<string, DeckCard[]> = {};
  for (const c of cards) {
    const t = c.type || 'Other';
    (buckets[t] ||= []).push(c);
  }
  return TYPE_ORDER
    .filter(t => buckets[t]?.length)
    .map(t => ({
      key: t,
      label: t + 's',
      cards: buckets[t],
      total: buckets[t].reduce((s, c) => s + c.qty, 0)
    }));
}
---

<Layout
  title="Star Wars Unlimited Top Decks & Tournament Decklists - Card Game Meta"
  description={description}
  canonical="https://www.swutcg.one/decklists"
  pageId="decklists"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Star Wars Unlimited Tournament Decklists",
    "description": description,
    "url": "https://www.swutcg.one/decklists",
    "numberOfItems": totalDecks
  })} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.swutcg.one/" },
      { "@type": "ListItem", "position": 2, "name": "Decklists", "item": "https://www.swutcg.one/decklists" }
    ]
  })} />

  <header>
    <Navigation activePage="decklists" />
    <h1>Star Wars Unlimited Top Decks &amp; Tournament Decklists</h1>
    <p class="page-intro">
      {totalDecks} <strong>tournament-winning Star Wars Unlimited decks</strong>. <a href="/builder">Open any in the deck builder</a>, <a href="/database">search the card list</a>, or <a href="/how-to-play">learn the rules</a>.
      {lastDeckDate && (() => {
        const [y, m, d] = lastDeckDate.slice(0, 10).split('-');
        return <span class="meta-note"> Â· last refreshed {d}/{m}/{y}</span>;
      })()}
    </p>
  </header>

  <main class="decklists-page">

    {totalDecks === 0 ? (
      <section class="empty-state">
        <h2>New tournament results coming soon</h2>
        <p>We're between events right now. Check back shortly. Fresh decklists land here as soon as the next major Star Wars Unlimited tournament wraps up. In the meantime, browse the <a href="/database">card database</a> or try the <a href="/builder">deck builder</a>.</p>
      </section>
    ) : (
      <div class="decklists-layout">
        <section class="decklists-table-section">
          <div class="decklists-search-row">
            <input
              type="search"
              id="decklistsSearch"
              class="decklists-search"
              placeholder="Search by deck name or event..."
              aria-label="Filter decklists"
              autocomplete="off"
              spellcheck="false"
            />
            <span class="decklists-search-count" id="decklistsSearchCount" aria-live="polite"></span>
          </div>
          <table id="decklistsTable">
            <thead>
              <tr>
                <th class="th-date">Date</th>
                <th class="th-leader">Deck</th>
                <th class="th-event">Event</th>
                <th class="th-result">Place</th>
              </tr>
            </thead>
            <tbody id="tableBody">
              {decks.map((deck, idx) => {
                const totalPrice = deckTotalPrice(deck.cards);
                const hasAnyTcgId = deck.cards.some(c => !!c.tcgPlayerId);
                const exportText = deckExportText(deck.cards);
                const heroes = pickHeroes(deck.cards, 2);
                return (
                  <>
                    <tr class="deck-row" id={`deck-${idx}`} data-deck-id={idx} data-colors={deck.colors.join(',')}>
                      <td class="col-date">{formatDate(deck.date)}</td>
                      <td class="col-leader">
                        <div class="deck-cell">
                          <div class="hero-stack">
                            {heroes.map(h => {
                              const ss = getImageSrcSet({ id: h.id });
                              return ss ? (
                                <img
                                  class="hero-thumb"
                                  src={ss.src}
                                  srcset={ss.srcset}
                                  sizes="56px"
                                  width="160"
                                  height="224"
                                  alt={h.name || h.id}
                                  loading="lazy"
                                  decoding="async"
                                />
                              ) : null;
                            })}
                          </div>
                          <div class="deck-name">{deck.deckName || '-'}</div>
                        </div>
                      </td>
                      <td class="col-event">
                        <div class="event-name">{deck.tournament || '-'}</div>
                      </td>
                      <td class="col-result">{(deck.placement || '').replace(/\s*place\s*$/i, '').trim() || '-'}</td>
                    </tr>
                    <tr class="deck-row-expanded" data-deck-id={idx} hidden>
                      <td colspan="4">
                        <div class="expanded-content">
                          {groupByType(deck.cards).map(group => (
                            <div class="deck-type-group">
                              <h3 class="deck-type-label">{group.label} ({group.total})</h3>
                              <div class="deck-grid">
                                {group.cards.map(card => {
                                  const ss = card.id ? getImageSrcSet({ id: card.id }) : null;
                                  const img = card.id ? getImageUrl({ id: card.id }) : null;
                                  return (
                                    <div class="deck-card-tile" data-card-id={card.id} title={card.name || card.id}>
                                      {ss ? (
                                        <img src={ss.src} srcset={ss.srcset} sizes="(max-width: 767px) 68px, 88px" alt={card.name || card.id} loading="lazy" decoding="async" width="160" height="224" />
                                      ) : img ? (
                                        <img src={img} alt={card.name || card.id} loading="lazy" decoding="async" width="160" height="224" />
                                      ) : (
                                        <div class="no-image">{card.id}</div>
                                      )}
                                      <div class="qty-badge">{card.qty}</div>
                                    </div>
                                  );
                                })}
                              </div>
                            </div>
                          ))}
                          <div class="deck-actions">
                            <button type="button" class="deck-action-btn copy-btn" data-export={exportText}>Copy / Export</button>
                            <a href={`/builder?deck=${idx}`} class="deck-action-btn use-btn">Use in Builder</a>
                            {hasAnyTcgId && totalPrice > 0 && (
                              <button type="button" class="deck-action-btn buy-btn" data-deck-idx={idx}>
                                <span class="buy-price">${totalPrice.toFixed(2)}</span>
                                <span class="buy-cart-icon" aria-hidden="true"></span>
                              </button>
                            )}
                          </div>
                        </div>
                      </td>
                    </tr>
                  </>
                );
              })}
            </tbody>
          </table>
        </section>

        <aside class="decklists-meta">
          <h2>Meta Snapshot</h2>
          <ol class="meta-list">
            {topDeckNames.map(d => (
              <li class="meta-row">
                <span class="meta-label" title={d.name}>{d.name}</span>
                <span class="meta-bar"><span class="meta-bar-fill" style={`width:${(d.count / topDeckNames[0].count) * 100}%; background:${d.colors.length === 0 ? 'var(--color-bg-tertiary)' : pairFill(d.colors)}`}></span></span>
                <span class="meta-count">{d.count}</span>
              </li>
            ))}
          </ol>
          {topDeckNames.length > 0 && (
            <p class="meta-snapshot-prose">
              The current <strong>Star Wars Unlimited</strong> meta is led by <strong>{topDeckNames.slice(0, 3).map(d => d.name).join(', ')}</strong>, which together account for <strong>{Math.round(topDeckNames.slice(0, 3).reduce((s, d) => s + d.count, 0) / Math.max(1, totalDecks) * 100)}%</strong> of tracked tournament decks. Across {totalDecks} competitive lists, <strong>{topDeckNames[0].name}</strong> is the most-played archetype. Search by deck name above, or click any row to see the full 50-card breakdown.
            </p>
          )}
          <p class="meta-source">
            {totalDecks} decks tracked
          </p>
        </aside>
      </div>
    )}
  </main>

  <!-- Cursor-following preview for cards inside the expanded deck rows -->
  <div id="cardHoverPreview" aria-hidden="true"></div>

  <!-- TCGplayer Buy modal â€” same alt-art-cycling pattern as /builder -->
  <div id="tcgPlayerModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="tcgModalTitle" hidden>
    <div class="modal-content tcg-modal-content">
      <button type="button" class="modal-close" id="tcgClose" aria-label="Close">&times;</button>
      <h2 id="tcgModalTitle" class="sr-only">Buy deck on TCGplayer</h2>
      <div class="modal-body">
        <div class="tcg-card-list" id="tcgCardList"></div>
      </div>
      <div class="modal-footer">
        <div class="footer-left">
          <button type="button" id="toggleSelectAllBtn" class="select-btn">Unselect All</button>
        </div>
        <div class="footer-right">
          <div class="total-price">Total: <span id="totalPrice">$0.00</span></div>
          <button type="button" id="buyOnTCGPlayer" class="tcg-buy-btn" disabled>Buy on TCGplayer</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Card pool for the modal's AA cycling -->
  <script is:inline type="application/json" id="card-pool" set:html={JSON.stringify(cardPool)}></script>

  <!-- One entry per deck â€” { idx: [{id, qty}, ...] } so the modal can
       look up exactly what's in the deck without rebuilding from DOM -->
  <script is:inline type="application/json" id="deck-payloads" set:html={JSON.stringify(
    decks.map(d => ({
      idx: decks.indexOf(d),
      cards: d.cards.map(c => ({ id: c.id, qty: c.qty }))
    }))
  )}></script>

  <script is:inline>
    (function() {
      const tbody = document.getElementById('tableBody');
      if (!tbody) return;
      const expanded = {};
      document.querySelectorAll('.deck-row-expanded').forEach(r => {
        expanded[r.dataset.deckId] = r;
      });

      tbody.addEventListener('click', e => {
        if (e.target.closest('button, a')) return;
        const main = e.target.closest('.deck-row');
        if (!main) return;
        const exp = expanded[main.dataset.deckId];
        if (!exp) return;
        const isOpen = !exp.hidden;
        exp.hidden = isOpen;
        main.classList.toggle('expanded', !isOpen);
      });

      // Auto-expand the row pointed to by the URL hash (e.g. #deck-3 from
      // the homepage's "Top Tournament Decks" cards). Runs on initial load
      // and on hashchange so back/forward navigation re-applies it.
      function openFromHash() {
        const m = (location.hash || '').match(/^#deck-(\d+)$/);
        if (!m) return;
        const main = document.getElementById('deck-' + m[1]);
        if (!main) return;
        const exp = expanded[main.dataset.deckId];
        if (exp && exp.hidden) {
          exp.hidden = false;
          main.classList.add('expanded');
        }
        main.scrollIntoView({ block: 'start', behavior: 'auto' });
      }
      openFromHash();
      window.addEventListener('hashchange', openFromHash);

      // Search filter â€” matches deck name, event name, and any visible
      // text inside each row. Hides the expanded row alongside its
      // parent so filtering doesn't leave orphan card grids behind.
      const searchInput = document.getElementById('decklistsSearch');
      const searchCount = document.getElementById('decklistsSearchCount');
      const totalRows = tbody.querySelectorAll('.deck-row').length;
      function applySearch() {
        const q = (searchInput.value || '').trim().toLowerCase();
        let visible = 0;
        tbody.querySelectorAll('.deck-row').forEach(row => {
          const hit = !q || row.textContent.toLowerCase().includes(q);
          row.style.display = hit ? '' : 'none';
          const exp = expanded[row.dataset.deckId];
          if (exp) exp.style.display = hit ? '' : 'none';
          if (hit) visible++;
        });
        searchCount.textContent = q
          ? `${visible} of ${totalRows} decks`
          : '';
      }
      if (searchInput) {
        searchInput.addEventListener('input', applySearch);
      }

      // Copy / Export
      tbody.addEventListener('click', e => {
        const btn = e.target.closest('.copy-btn');
        if (!btn) return;
        e.preventDefault(); e.stopPropagation();
        navigator.clipboard.writeText(btn.dataset.export || '').then(() => {
          const orig = btn.textContent;
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 1500);
        });
      });

      // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      // CURSOR-FOLLOWING HOVER PREVIEW (desktop only)
      // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      const preview = document.getElementById('cardHoverPreview');
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (canHover && preview) {
        const PREVIEW_W = 320;
        const OFFSET = 20;
        let currentSrc = '';

        const showPreview = (e, cardId) => {
          if (!cardId) return;
          const src = '/cards/' + cardId + '-640w.webp';
          if (src !== currentSrc) {
            preview.innerHTML = '<img src="' + src + '" alt="" />';
            currentSrc = src;
          }
          let left = e.clientX + OFFSET;
          let top = e.clientY;
          if (left + PREVIEW_W > window.innerWidth) left = e.clientX - PREVIEW_W - OFFSET;
          const halfH = PREVIEW_W * 0.7;
          if (top - halfH < 0) top = halfH + 10;
          if (top + halfH > window.innerHeight) top = window.innerHeight - halfH - 10;
          preview.style.left = left + 'px';
          preview.style.top = top + 'px';
          preview.style.transform = 'translateY(-50%)';
          preview.style.display = 'block';
        };
        const hidePreview = () => {
          preview.style.display = 'none';
          currentSrc = '';
        };

        tbody.addEventListener('mousemove', (e) => {
          const tile = e.target.closest('.deck-card-tile');
          if (!tile) { hidePreview(); return; }
          const cardId = tile.dataset.cardId;
          if (!cardId) { hidePreview(); return; }
          showPreview(e, cardId);
        });
        tbody.addEventListener('mouseleave', hidePreview);
      }

      // Touch devices: tap any card tile in an expanded deck row to open
      // the full-size image as a centered overlay; tap anywhere to dismiss.
      if (!canHover && preview) {
        tbody?.addEventListener('click', (e) => {
          const tile = e.target.closest('.deck-card-tile');
          if (!tile) return;
          const cardId = tile.dataset.cardId;
          if (!cardId) return;
          e.stopPropagation();
          preview.innerHTML = '<img src="/cards/' + cardId + '-640w.webp" alt="" />';
          preview.classList.add('preview-centered');
          preview.style.display = 'block';
        });
        document.addEventListener('click', (e) => {
          if (preview.style.display === 'block' && !preview.contains(e.target)) {
            preview.style.display = 'none';
            preview.classList.remove('preview-centered');
          }
        });
      }

      // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      // TCGPLAYER BUY MODAL (per-deck)
      // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      let cardPool = [];
      let cardById = new Map();
      let deckPayloads = [];
      try {
        cardPool = JSON.parse(document.getElementById('card-pool').textContent || '[]');
        deckPayloads = JSON.parse(document.getElementById('deck-payloads').textContent || '[]');
        cardById = new Map(cardPool.map(c => [c.id, c]));
      } catch {}

      const TCG_AFFILIATE_BASE = 'https://partner.tcgplayer.com/c/7021525/1780961/21018';
      const tcgModal = document.getElementById('tcgPlayerModal');
      const tcgCardList = document.getElementById('tcgCardList');
      const totalPriceLabel = document.getElementById('totalPrice');
      const buyOnTCGBtn = document.getElementById('buyOnTCGPlayer');
      const tcgClose = document.getElementById('tcgClose');

      const escAttr = s => String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');

      function recalcTotal() {
        let total = 0, anySelected = false;
        tcgCardList.querySelectorAll('.tcg-card-item').forEach(item => {
          const cb = item.querySelector('.tcg-card-checkbox');
          if (!cb || cb.disabled) { item.classList.remove('selected'); return; }
          const qty = Math.max(1, Math.min(99, parseInt(item.querySelector('.tcg-quantity-input').value) || 1));
          const price = parseFloat(item.dataset.price) || 0;
          if (cb.checked) {
            total += price * qty;
            item.classList.add('selected');
            anySelected = true;
          } else {
            item.classList.remove('selected');
          }
        });
        totalPriceLabel.textContent = '$' + total.toFixed(2);
        buyOnTCGBtn.disabled = !anySelected;
        const tBtn = document.getElementById('toggleSelectAllBtn');
        if (tBtn) tBtn.textContent = anySelected ? 'Unselect All' : 'Select All';
      }

      function openBuyModal(deckIdx) {
        const payload = deckPayloads[deckIdx];
        if (!payload) return;
        const html = payload.cards.map(({ id, qty }) => {
          const c = cardById.get(id);
          if (!c) return '';
          const price = c.price ? Number(c.price) : 0;
          const tpid = c.tcgPlayerId || '';
          const buyable = price > 0 && tpid;
          const totalCardPrice = (price * qty).toFixed(2);
          const siblings = cardPool.filter(s => s.baseId === c.baseId);
          const hasVariants = siblings.length > 1;
          return `
            <div class="tcg-card-item ${buyable ? 'selected' : 'disabled'}"
                 data-card-id="${escAttr(id)}" data-tcg-id="${escAttr(tpid)}"
                 data-price="${price}" data-qty="${qty}">
              <input type="checkbox" class="tcg-card-checkbox" ${buyable ? 'checked' : 'disabled'}>
              <div class="tcg-card-img-wrapper">
                ${hasVariants ? '<button type="button" class="tcg-aa-prev-btn tcg-aa-badge-left" aria-label="Previous printing">â—€</button>' : ''}
                <img class="tcg-card-img"
                     src="/cards/${escAttr(id)}-160w.webp"
                     srcset="/cards/${escAttr(id)}-160w.webp 160w, /cards/${escAttr(id)}-640w.webp 640w"
                     sizes="120px" width="160" height="224"
                     alt="${escAttr(c.name || id)}" />
                ${hasVariants ? '<button type="button" class="tcg-aa-next-btn tcg-aa-badge-right" aria-label="Next printing">â–¶</button>' : ''}
              </div>
              <div class="tcg-card-info">
                <div class="tcg-card-name">${escAttr(c.name || id)}</div>
                <div class="tcg-card-quantity">
                  <input type="number" class="tcg-quantity-input" min="1" max="99" value="${qty}" ${buyable ? '' : 'disabled'}>
                  <div class="tcg-card-price">${price > 0 ? '$' + totalCardPrice : 'N/A'}</div>
                </div>
              </div>
            </div>
          `;
        }).filter(Boolean).join('');
        tcgCardList.innerHTML = html;
        tcgModal.hidden = false;
        recalcTotal();
      }

      function cycleVariant(item, direction) {
        const cardId = item.dataset.cardId;
        const card = cardById.get(cardId);
        if (!card) return;
        const siblings = cardPool
          .filter(s => s.baseId === card.baseId)
          .sort((a, b) => Number(a.tcgPlayerId || 0) - Number(b.tcgPlayerId || 0));
        if (siblings.length <= 1) return;
        const curIdx = siblings.findIndex(s => s.id === cardId);
        const next = siblings[(curIdx + direction + siblings.length) % siblings.length];
        const buyable = next.tcgPlayerId && next.price > 0;
        const qty = parseInt(item.dataset.qty) || 1;
        item.dataset.cardId = next.id;
        item.dataset.tcgId = next.tcgPlayerId || '';
        item.dataset.price = String(next.price ?? 0);
        item.classList.toggle('disabled', !buyable);
        const img = item.querySelector('.tcg-card-img');
        if (img) {
          img.src = `/cards/${next.id}-160w.webp`;
          img.srcset = `/cards/${next.id}-160w.webp 160w, /cards/${next.id}-640w.webp 640w`;
          img.alt = next.name || next.id;
        }
        const cb = item.querySelector('.tcg-card-checkbox');
        if (cb) { cb.disabled = !buyable; cb.checked = buyable; }
        const qtyInput = item.querySelector('.tcg-quantity-input');
        if (qtyInput) qtyInput.disabled = !buyable;
        const priceEl = item.querySelector('.tcg-card-price');
        if (priceEl) priceEl.textContent = next.price > 0 ? '$' + ((next.price ?? 0) * qty).toFixed(2) : 'N/A';
        recalcTotal();
      }

      // Buy button on each deck row
      tbody.addEventListener('click', e => {
        const btn = e.target.closest('.buy-btn');
        if (!btn) return;
        e.preventDefault(); e.stopPropagation();
        openBuyModal(parseInt(btn.dataset.deckIdx) || 0);
      });

      tcgClose?.addEventListener('click', () => { tcgModal.hidden = true; });
      tcgModal?.addEventListener('click', e => { if (e.target === tcgModal) tcgModal.hidden = true; });

      tcgCardList?.addEventListener('click', e => {
        const prev = e.target.closest('.tcg-aa-prev-btn');
        const next = e.target.closest('.tcg-aa-next-btn');
        if (prev || next) {
          e.stopPropagation();
          cycleVariant(e.target.closest('.tcg-card-item'), prev ? -1 : 1);
          return;
        }
        if (e.target.closest('.tcg-quantity-input') || e.target.closest('.tcg-card-checkbox')) return;
        const item = e.target.closest('.tcg-card-item');
        if (!item || item.classList.contains('disabled')) return;
        const cb = item.querySelector('.tcg-card-checkbox');
        if (cb && !cb.disabled) {
          cb.checked = !cb.checked;
          recalcTotal();
        }
      });
      tcgCardList?.addEventListener('change', e => {
        if (e.target.classList.contains('tcg-card-checkbox') ||
            e.target.classList.contains('tcg-quantity-input')) recalcTotal();
      });
      tcgCardList?.addEventListener('input', e => {
        if (e.target.classList.contains('tcg-quantity-input')) recalcTotal();
      });

      document.getElementById('toggleSelectAllBtn')?.addEventListener('click', () => {
        const boxes = tcgCardList.querySelectorAll('.tcg-card-checkbox:not(:disabled)');
        const anyChecked = Array.from(boxes).some(cb => cb.checked);
        boxes.forEach(cb => cb.checked = !anyChecked);
        recalcTotal();
      });

      buyOnTCGBtn?.addEventListener('click', () => {
        const selected = [];
        tcgCardList.querySelectorAll('.tcg-card-item').forEach(item => {
          const cb = item.querySelector('.tcg-card-checkbox');
          if (!cb || !cb.checked || cb.disabled) return;
          const tpid = item.dataset.tcgId;
          const qty = Math.max(1, Math.min(99, parseInt(item.querySelector('.tcg-quantity-input').value) || 1));
          if (tpid) selected.push(qty + '-' + tpid);
        });
        if (!selected.length) return;
        const massUrl = 'https://www.tcgplayer.com/massentry?c=' + encodeURIComponent(selected.join('||')) + '&productline=Star Wars Unlimited';
        const affUrl = TCG_AFFILIATE_BASE + '?u=' + encodeURIComponent(massUrl) + '&subId1=swutcg-decklist';
        window.open(affUrl, '_blank', 'noopener');
      });

      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !tcgModal.hidden) tcgModal.hidden = true;
      });
    })();
  </script>

  <style is:global>

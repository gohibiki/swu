---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import { loadCardData } from '../utils/loadCardData.js';
import { loadDecklists } from '../utils/loadDecklists.js';
import { loadSets, getLatestMainSet } from '../utils/setData.js';
import { getImageSrcSet } from '../utils/helpers.js';
import { faqs as faqEntries } from '../data/faqs.js';

interface Card { id: string; name?: string; slug?: string; set?: string; rarity?: string; color?: string; }

const { cards } = await loadCardData() as { cards: Card[] };
const { sets } = loadSets();
const { decks } = await loadDecklists() as { decks: any[] };

// Dedupe: count base cards only (exclude alt-art variants like ID_p1).
const uniqueCardIds = new Set<string>();
for (const c of cards) {
  if (!c.id) continue;
  uniqueCardIds.add(c.id.split('_')[0]);
}
const totalCards = uniqueCardIds.size;
const totalSets = sets.length;

const latestSet = getLatestMainSet();
const latestSetId = latestSet?.id || null;

const latestCards = cards.filter(c => c.set === latestSetId && !c.id.includes('_'));
const spotlight = (
  latestCards.filter(c => c.rarity === 'LR')
    .concat(latestCards.filter(c => c.rarity === 'SR'))
    .concat(latestCards.filter(c => c.rarity === 'R'))
).slice(0, 8);

const lcpCard = spotlight[0];
const lcpSrcSet = lcpCard ? getImageSrcSet(lcpCard) : null;

// Top decks â€” most-recent 6 with at least one image-able card.
const topDecks = decks.slice(0, 6).map((d: any, idx: number) => {
  // Same hero pick as /decklists for cross-page visual consistency:
  // rarest Units first, qty as tiebreak, cost as final tiebreak.
  // Resources/Pilots/Commands/Bases excluded â€” Units (Mobile Suits)
  // are the most recognizable cards.
  const order = ['LR', 'SR', 'R', 'U', 'C', 'P'];
  const heroes = d.cards
    .filter((c: any) => c.id && (c.type || '').toLowerCase() === 'unit')
    .sort((a: any, b: any) => {
      const rDiff = order.indexOf(a.rarity || 'C') - order.indexOf(b.rarity || 'C');
      if (rDiff !== 0) return rDiff;
      if ((b.qty ?? 0) !== (a.qty ?? 0)) return (b.qty ?? 0) - (a.qty ?? 0);
      return (b.cost ?? -1) - (a.cost ?? -1);
    })
    .slice(0, 2);
  return {
    idx,
    deckName: d.deckName || d.deckProfile || '-',
    author: d.author || '',
    date: d.date,
    set: d.set,
    placement: d.placement || '',
    colors: d.colors as string[],
    heroes
  };
});

const description = `Star Wars Unlimited database with ${totalCards.toLocaleString()} Star Wars Unlimited (SWU) cards from ${totalSets} sets, tournament decklists, and the comprehensive rules.`;

// Release roadmap â€” sourced live from TCGCSV's group `publishedOn` dates
// (the same data the daily fetch-data pulls). New sets appear as soon as
// TCGplayer lists them, which usually precedes Fantasy Flight Games's street date by
// 1-3 months. No more hand-coded dates to babysit.
//
// `manualUpcoming`: escape hatch for sets that Fantasy Flight Games has announced but
// TCGplayer hasn't listed yet. Empty by default â€” only populate if you
// want to surface a set ahead of TCGplayer's catalog.
const KIND_LABEL: Record<string, string> = {
  main:    'Booster',
  extra:   'Extra Booster',
  starter: 'Starter Deck',
  promo:   'Promo',
  special: 'Special',
};
const manualUpcoming: { code: string; name: string; date: string; kind: keyof typeof KIND_LABEL }[] = [
  // Example: { code: 'GD05', name: 'Freedom Ascension', date: '2026-07-24', kind: 'main' }
];

function fmtDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const todayMs = Date.now();
const SOON_DAYS = 60;

// Pull only product-shipping sets (boosters / extras / starters). Promos
// and tokens don't belong on a release roadmap â€” they ship rolling and
// would clutter the timeline.
const ROADMAP_KINDS = new Set(['main', 'extra', 'starter']);
const liveRoadmap = (sets as any[])
  .filter((s: any) => ROADMAP_KINDS.has(s.kind) && s.release)
  .map((s: any) => ({
    code: s.id as string,
    name: (s.name as string).replace(/^Starter Deck \d+:\s*/, ''),
    date: s.release as string,
    kind: s.kind as keyof typeof KIND_LABEL,
  }));

// Live data wins on `code` collision â€” once TCGplayer lists a set, the
// manual entry for it becomes redundant and is dropped automatically.
const liveCodes = new Set(liveRoadmap.map(r => r.code));
const filteredManual = manualUpcoming.filter(r => !liveCodes.has(r.code));

const roadmapAll = [...liveRoadmap, ...filteredManual]
  .sort((a, b) => a.date.localeCompare(b.date))
  .map(item => {
    const ms = new Date(item.date).getTime();
    const daysFromNow = (ms - todayMs) / 86_400_000;
    let status: 'released' | 'upcoming' | 'announced';
    if (daysFromNow < 0) status = 'released';
    else if (daysFromNow <= SOON_DAYS) status = 'upcoming';
    else status = 'announced';
    return { ...item, status };
  });

// Show the 3 most recent past releases + everything still upcoming, so
// the section stays focused on "what's next" without dropping all history.
const released = roadmapAll.filter(r => r.status === 'released').slice(-3);
const future = roadmapAll.filter(r => r.status !== 'released');
const roadmap = [...released, ...future];

// FAQ â€” short, direct answers to high-volume search queries.
// Source: KeywordStats CSV (top: swu tcg deck builder, swu tcg online,
// swu tcg meta, swu tcg decks, swu tcg card list) + 2026 Fantasy Flight Games
// release schedule research.
const faqs = [
  {
    q: "What is Star Wars Unlimited?",
    a: "Star Wars Unlimited (SWU) is a two-player trading card game by Fantasy Flight Games, launched in March 2024. Each player chooses a Leader and a Base, then builds a main deck of at least 50 cards. Units fight in two arenas (Ground and Space), and the game ends when one player reduces the opponent's Base HP to zero."
  },
  {
    q: "How do I build a deck?",
    a: "A legal SWU deck contains exactly one Leader, exactly one Base, and a main deck of at least 50 cards (with no upper limit). You may have a maximum of 3 copies of any card by name. Cards from your Leader's two aspects (Alignment plus Style) play without penalty; off-aspect cards cost 2 extra Resources. The full rules are on the /how-to-play page."
  },
  {
    q: "Where can I find a Star Wars Unlimited deck builder?",
    a: "The /builder page on this site lets you pick a Leader, choose a Base, and add cards to a 50-card minimum main deck. Aspect matching and the 3-copy limit are enforced live, and you can export the list or buy it on TCGplayer in one click."
  },
  {
    q: "Where do I find competitive decklists?",
    a: "Tournament decklists from Regional Qualifiers, Showdowns, Sector and Galactic Championships will populate the /decklists page (pipeline pending). For now, results from Fantasy Flight Games organized play and community-run events at starwarsunlimited.com and melee.gg are the source of truth."
  },
  {
    q: "Can I play Star Wars Unlimited online?",
    a: "There is no official Fantasy Flight Games-hosted digital client as of mid-2026. Most digital play happens on Tabletop Simulator (the most active community option) and through informal Discord matchmaking. The official Star Wars Unlimited Companion app handles deck registration and event check-ins but does not include digital gameplay."
  },
  {
    q: "What's the latest set?",
    a: `The most recent set indexed in this database is ${latestSet?.name || 'the current main release'} (${latestSetId || ''}). Fantasy Flight Games releases roughly one main set every 3-4 months. The release order so far: Spark of Rebellion, Shadows of the Galaxy, Twilight of the Republic, Jump to Lightspeed, Legends of the Force, Secrets of Power, A Lawless Time, Ashes of the Empire, Twin Suns. Check starwarsunlimited.com for region-specific dates.`
  },
  {
    q: "Where can I buy Star Wars Unlimited singles and sealed product?",
    a: "Sealed product (booster boxes, starter decks, prerelease kits) is sold through Fantasy Flight Games authorized retailers and most local game stores. Singles are widely available on TCGplayer. Card pages on this site link directly to TCGplayer with affiliate tagging, and purchases support the site at no extra cost to you."
  },
  {
    q: "What deck should a beginner buy?",
    a: "Start with a Two-Player Starter Set or an Intro Battle product (such as Intro Battle: Hoth). Each contains two pre-built tournament-legal decks with their Leaders, Bases, and damage tokens, plus a rules sheet. Pick the one whose Leaders match the Star Wars era you most enjoy, then move on to a booster box of the latest main set."
  },
  {
    q: "What do Cost, Power, HP, and Arena mean on a card?",
    a: "Cost is the number of Resources you exhaust to play the card. Power is the damage a Unit deals in combat. HP is hit points; when reduced to zero the Unit is defeated. Arena (Units only) is either Ground or Space, and Units only fight other Units in the same arena. Leaders, Bases, Events, and Upgrades have no arena."
  },
  {
    q: "What are the keyword abilities?",
    a: "Star Wars Unlimited keywords include Ambush (act immediately after deploy), Grit (gain power equal to damage taken), Overwhelm (excess damage flows to the base), Raid (gain power when attacking the base), Restore (heal the base when attacking the base), Saboteur (ignore Sentinel), Sentinel (must be attacked first), Shielded (one-time shield token on deploy), and Smuggle (deploy from hyperspace at a discount). Each is filterable on the /database page."
  }
];
---

<Layout
  title="Star Wars Unlimited Database - Cards, Decks & Rules"
  description={description}
  canonical="https://www.swutcg.one/"
  pageId="home"
>
  <Fragment slot="head">
    {lcpSrcSet && (
      <link
        rel="preload"
        as="image"
        href={lcpSrcSet.src}
        imagesrcset={lcpSrcSet.srcset}
        imagesizes="360px"
        fetchpriority="high"
      />
    )}
  </Fragment>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "SWUTCG.one",
    "url": "https://www.swutcg.one/",
    "description": "Star Wars Unlimited database with card search, rules, and decklists.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://www.swutcg.one/database?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

  <Navigation activePage="home" />

  <!-- Starfield + nebula backdrop (homepage only). The site-wide
       .page-bg div is hidden via CSS below so this becomes the bg. -->
  <canvas id="starfield" aria-hidden="true"></canvas>
  <div class="nebula" aria-hidden="true"></div>

  <main class="home">
    <header class="hero">
      <div class="hero-tag">
        <span class="hero-tag-dot"></span>
        <span>Daily sync Â· {totalCards.toLocaleString()} cards indexed</span>
      </div>
      <h1 class="hero-title">Star Wars Unlimited Database</h1>
      <p class="hero-lede">
        <strong>Star Wars Unlimited database</strong> with <strong>{totalCards.toLocaleString()} cards</strong> across <strong>{totalSets}</strong> sets. Search every card, build a deck, or study tournament decklists.
      </p>
      <form class="hero-search" action="/database" method="get" role="search">
        <input
          type="search"
          name="q"
          class="hero-search-input"
          placeholder="Search by name, trait, or keyword, e.g. Char's Zaku"
          aria-label="Search the card database"
          autocomplete="off"
          spellcheck="false"
        />
        <button type="submit" class="hero-search-btn" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16" y1="16" x2="21" y2="21"></line>
          </svg>
          <span>Search</span>
        </button>
      </form>
      <div class="hero-stats">
        <div class="hero-stat"><span class="hero-stat-num">{totalCards.toLocaleString()}</span><span class="hero-stat-label">Cards indexed</span></div>
        <div class="hero-stat-divider" aria-hidden="true"></div>
        <div class="hero-stat"><span class="hero-stat-num">{totalSets}</span><span class="hero-stat-label">Sets tracked</span></div>
        <div class="hero-stat-divider" aria-hidden="true"></div>
        <div class="hero-stat"><span class="hero-stat-num">{decks.length}</span><span class="hero-stat-label">Decklists</span></div>
      </div>
    </header>

    {spotlight.length > 0 && latestSet && (
      <section class="section">
        <div class="section-head">
          <div>
            <div class="section-eyebrow">// Latest drop</div>
            <h2 class="section-title">New booster</h2>
          </div>
          <a href={`/set/${latestSet.slug || latestSetId}`} class="section-link">All sets</a>
        </div>
        <div class="drop" data-set-code={latestSetId}>
          <div class="drop-info">
            <div class="drop-meta">
              <span class="drop-pill">Live</span>
              {latestSet.release && (
                <span class="drop-date">Released {fmtDate(latestSet.release)}</span>
              )}
            </div>
            <h3 class="drop-title">{latestSet.name}</h3>
            <p class="drop-desc">
              {spotlight.length} highlighted printings from the latest Fantasy Flight Games release. Includes the new LR, SR, and R units defining the current meta.
            </p>
            <a href={`/set/${latestSet.slug || latestSetId}`} class="drop-cta">Browse {latestSetId}</a>
          </div>
          {(() => {
            const picks = spotlight.slice(0, 5);
            const hero = picks[0];
            const smalls = picks.slice(1, 5);
            return (
              <div class="drop-cards">
                {hero && (() => {
                  const ss = getImageSrcSet(hero);
                  const altText = `${hero.name} (${hero.id})`;
                  return (
                    <a href={`/card/${hero.slug || hero.id}`} class="drop-card drop-card-hero" aria-label={altText}>
                      {ss && (
                        <img src={ss.src} srcset={ss.srcset} sizes="360px" alt={altText} width="350" height="490" loading="eager" fetchpriority="high" decoding="async" />
                      )}
                    </a>
                  );
                })()}
                {smalls.map(card => {
                  const ss = getImageSrcSet(card);
                  const altText = `${card.name} (${card.id})`;
                  return (
                    <a href={`/card/${card.slug || card.id}`} class="drop-card drop-card-small" aria-label={altText}>
                      {ss && (
                        <img src={ss.src} srcset={ss.srcset} sizes="180px" alt={altText} width="350" height="490" loading="lazy" decoding="async" />
                      )}
                    </a>
                  );
                })}
              </div>
            );
          })()}
        </div>
      </section>
    )}

    <section class="section">
      <div class="section-head">
        <div>
          <div class="section-eyebrow">// 2026 Schedule</div>
          <h2 class="section-title">Release timeline</h2>
        </div>
      </div>
      <div class="timeline">
        <div class="timeline-line" aria-hidden="true"></div>
        <div class="timeline-sweep" aria-hidden="true"></div>
        <div class="timeline-track" style={`--tl-count: ${roadmap.length};`}>
          {roadmap.map(item => (
            <div class={`tl-node tl-${item.status}`}>
              <div class="tl-dot" aria-hidden="true"></div>
              <div class="tl-code">{item.code}</div>
              <div class="tl-name">{item.name}</div>
              <div class="tl-date">{fmtDate(item.date)}</div>
              <span class="tl-tag">{item.status === 'released' ? 'Released' : item.status === 'upcoming' ? 'Live now' : 'Announced'}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {topDecks.length > 0 && (
      <section class="section">
        <div class="section-head">
          <div>
            <div class="section-eyebrow">// Tournament meta</div>
            <h2 class="section-title">Top decks this week</h2>
          </div>
          <a href="/decklists" class="section-link">All decklists</a>
        </div>
        <div class="decks-grid">
          {topDecks.slice(0, 4).map((deck: any) => {
            const place = (deck.placement || '').replace(/\s*place\s*$/i, '').trim();
            return (
              <a href={`/decklists#deck-${deck.idx}`} class="deck-card">
                <div class="deck-card-head">
                  <span>{deck.set} Â· {fmtDate(deck.date)}</span>
                  {place && <span class="deck-card-place">{place}</span>}
                </div>
                <div class="deck-card-thumbs">
                  {deck.heroes.map((h: any) => {
                    const ss = getImageSrcSet({ id: h.id });
                    return ss ? (
                      <img src={ss.src} srcset={ss.srcset} sizes="100px" width="100" height="140" alt={h.name || h.id} loading="lazy" decoding="async" />
                    ) : null;
                  })}
                </div>
                <h3 class="deck-card-name">{deck.deckName}</h3>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="section">
      <div class="section-head">
        <div>
          <div class="section-eyebrow">// What's here</div>
          <h2 class="section-title">Modules</h2>
        </div>
      </div>
      <div class="features-grid">
        <a href="/how-to-play" class="feature-tile">
          <div class="feature-tile-eyebrow">// 01</div>
          <h3 class="feature-tile-title">How to Play</h3>
          <p class="feature-tile-desc">Five-minute walkthrough of the rules, turn flow, and keyword effects.</p>
        </a>
        <a href="/database" class="feature-tile">
          <div class="feature-tile-eyebrow">// 02</div>
          <h3 class="feature-tile-title">Card Database</h3>
          <p class="feature-tile-desc">Filter every card by color, type, cost, AP/HP, level, rarity, or keyword. {totalCards.toLocaleString()} entries.</p>
        </a>
        <a href="/builder" class="feature-tile">
          <div class="feature-tile-eyebrow">// 03</div>
          <h3 class="feature-tile-title">Deck Builder</h3>
          <p class="feature-tile-desc">Build with the full card pool. Import, export, share via URL, and price the whole deck on TCGplayer.</p>
        </a>
        <a href="/decklists" class="feature-tile">
          <div class="feature-tile-eyebrow">// 04</div>
          <h3 class="feature-tile-title">Decklists</h3>
          <p class="feature-tile-desc">Tournament-winning lists with the full 50-card breakdown. Open any in the builder.</p>
        </a>
      </div>
    </section>

    <section class="section faq" id="faq">
      <div class="section-head">
        <div>
          <div class="section-eyebrow">// Knowledge base</div>
          <h2 class="section-title">Frequently asked</h2>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => {
          const detail = faqEntries.find((e: any) => e.q === f.q && e.long);
          return (
            <details class="faq-item" open={i === 0}>
              <summary>{f.q}</summary>
              <p set:html={f.a}></p>
              {detail && (
                <p class="faq-read-more">
                  <a href={`/faq/${detail.slug}`}>Read the full guide</a>
                </p>
              )}
            </details>
          );
        })}
      </div>
    </section>
  </main>

  <!-- Starfield: 3 parallax layers, gentle drift, optional twinkle +
       shooting stars. Honors prefers-reduced-motion. -->
  <script is:inline>
    (() => {
      const canvas = document.getElementById('starfield');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let w, h, dpr;
      let stars = [];
      let shootingStars = [];
      let lastShoot = 0;
      const settings = { density: 1, twinkle: true, shooting: true, drift: 0.04 };

      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = window.innerWidth;
        h = window.innerHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        canvas.style.width = w + 'px';
        canvas.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        seed();
      }
      function seed() {
        stars = [];
        const count = Math.floor((w * h / 6000) * settings.density);
        for (let i = 0; i < count; i++) {
          const layer = Math.random();
          const z = layer < 0.6 ? 0.3 : (layer < 0.9 ? 0.6 : 1.0);
          stars.push({
            x: Math.random() * w, y: Math.random() * h,
            r: (0.3 + Math.random() * 1.4) * z, z,
            phase: Math.random() * Math.PI * 2,
            speed: 0.5 + Math.random() * 2,
            hue: Math.random() < 0.12 ? (Math.random() < 0.5 ? '#FFD9A8' : '#A8C8FF') : '#FFFFFF',
          });
        }
      }
      function spawnShooting() {
        const fromTop = Math.random() < 0.5;
        const x = fromTop ? Math.random() * w : -50;
        const y = fromTop ? -50 : Math.random() * h * 0.5;
        shootingStars.push({
          x, y, vx: 6 + Math.random() * 4, vy: 2.5 + Math.random() * 1.5,
          life: 0, maxLife: 90 + Math.random() * 40,
        });
      }
      let t0 = performance.now();
      let rafId = 0;
      function frame(now) {
        const dt = Math.min(50, now - t0);
        t0 = now;
        ctx.clearRect(0, 0, w, h);
        for (const s of stars) {
          s.x += settings.drift * s.z * (dt / 16);
          s.y += settings.drift * 0.3 * s.z * (dt / 16);
          if (s.x > w + 5) s.x = -5;
          if (s.y > h + 5) s.y = -5;
          s.phase += 0.002 * s.speed * dt;
          const tw = settings.twinkle ? (0.55 + 0.45 * Math.sin(s.phase)) : 0.9;
          const alpha = 0.35 + 0.55 * tw * s.z;
          ctx.beginPath();
          ctx.fillStyle = s.hue;
          ctx.globalAlpha = alpha;
          ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          ctx.fill();
          if (s.r > 1.2) {
            ctx.globalAlpha = alpha * 0.18;
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.r * 3, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        ctx.globalAlpha = 1;
        if (settings.shooting && now - lastShoot > 4500 + Math.random() * 4000) {
          spawnShooting();
          lastShoot = now;
        }
        for (let i = shootingStars.length - 1; i >= 0; i--) {
          const s = shootingStars[i];
          s.x += s.vx; s.y += s.vy; s.life++;
          const fade = 1 - (s.life / s.maxLife);
          if (fade <= 0) { shootingStars.splice(i, 1); continue; }
          const tailLen = 80;
          const grad = ctx.createLinearGradient(s.x, s.y, s.x - s.vx * tailLen / 6, s.y - s.vy * tailLen / 6);
          grad.addColorStop(0, `rgba(255,255,255,${0.9 * fade})`);
          grad.addColorStop(0.5, `rgba(241,196,74,${0.4 * fade})`);
          grad.addColorStop(1, 'rgba(255,255,255,0)');
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.8;
          ctx.beginPath();
          ctx.moveTo(s.x, s.y);
          ctx.lineTo(s.x - s.vx * tailLen / 6, s.y - s.vy * tailLen / 6);
          ctx.stroke();
          ctx.fillStyle = `rgba(255,255,255,${fade})`;
          ctx.beginPath();
          ctx.arc(s.x, s.y, 1.6, 0, Math.PI * 2);
          ctx.fill();
        }
        rafId = requestAnimationFrame(frame);
      }
      function start() {
        if (rafId) return;
        t0 = performance.now();
        rafId = requestAnimationFrame(frame);
      }
      function stop() {
        if (!rafId) return;
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
      window.addEventListener('resize', resize);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop(); else start();
      });
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        settings.twinkle = false;

---
export interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;
---

<nav class="main-nav" transition:persist="nav">
  <ul>
    <li>
      <a href="/" class={activePage === 'home' ? 'active' : ''}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
        </svg>
        <span>Home</span>
      </a>
    </li>
    <li>
      <a href="/decklists" class={activePage === 'decklists' ? 'active' : ''}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M0 0h24v24H0V0z" fill="none"/>
          <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12zM10 9h8v2h-8zm0 3h4v2h-4z"/>
        </svg>
        <span>Decklists</span>
      </a>
    </li>
    <li>
      <a href="/database" class={activePage === 'database' ? 'active' : ''}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 3C7.58 3 4 4.79 4 7s3.58 4 8 4 8-1.79 8-4-3.58-4-8-4z"/>
          <path d="M4 11v4c0 2.21 3.58 4 8 4s8-1.79 8-4v-4c0 2.21-3.58 4-8 4s-8-1.79-8-4z"/>
          <path d="M4 16v4c0 2.21 3.58 4 8 4s8-1.79 8-4v-4c0 2.21-3.58 4-8 4s-8-1.79-8-4z"/>
        </svg>
        <span>Database</span>
      </a>
    </li>
    <li>
      <a href="/builder" class={activePage === 'builder' ? 'active' : ''}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
        </svg>
        <span>Builder</span>
      </a>
    </li>
  </ul>
</nav>

<!-- The nav DOM is persisted across Astro view transitions, so the
     server-rendered .active class stays frozen from the first page
     load. Sync it to the current pathname on every page-load event. -->
<script>
  const syncActiveNav = () => {
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('.main-nav li a').forEach((link) => {
      const href = (link as HTMLAnchorElement).getAttribute('href') || '';
      if (href.startsWith('http')) return;
      const normalized = href.replace(/\/$/, '') || '/';
      link.classList.toggle('active', normalized === path);
    });
  };
  document.addEventListener('astro:page-load', syncActiveNav);
</script>

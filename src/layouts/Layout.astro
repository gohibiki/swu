---
import { ClientRouter } from 'astro:transitions';
import '../styles/base.css';
import '../styles/typography.css';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/dark-mode.css';
import { SITE_NAME, SITE_URL } from '../utils/constants.js';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  pageId?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Star Wars Unlimited card database with search by ink, type, cost, and rarity.',
  canonical,
  pageId,
  ogType = 'website',
  noindex = false
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = `${SITE_URL}/social-preview.png`;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:160, max-image-preview:large'} />
    <!-- Impact Radius site verification (TCGPlayer affiliate tracking).
         Same token as optcg.one â€” both sites tied to the same Impact account. -->
    <meta name="impact-site-verification" content="09339c29-f5b1-4301-94c2-ae4a82e1eb74" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" title="Sitemap" />

    <!-- Preload critical fonts (Eurostile = Fantasy Flight Games's official Star Wars Unlimited typeface) -->
    <!-- Only preload the two fonts the LCP elements actually use; the
         heading-only Extended Medium and the Latin-extended Roboto
         fallback can load lazily without impacting first paint. -->
    <link rel="preload" href="/fonts/eurostile/EurostileRound-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/eurostile/EurostileRound-Heavy.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Speed up TCGPlayer affiliate clicks (price badges, buy buttons) -->
    <link rel="dns-prefetch" href="https://partner.tcgplayer.com" />
    <link rel="dns-prefetch" href="https://www.tcgplayer.com" />
    <link rel="preconnect" href="https://partner.tcgplayer.com" crossorigin />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon set -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <!-- PWA manifest -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Mobile browser chrome color (Federation Yellow) -->
    <meta name="theme-color" content="#1A237E" />

    <!-- Site-wide Schema.org: WebSite (with SearchAction) + Organization.
         Per-page LD+JSON (FAQ, Article, BreadcrumbList, Product, etc.) is
         emitted from the page itself in addition to these. -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "swutcg.one - Star Wars Unlimited Database",
      "url": SITE_URL + "/",
      "potentialAction": {
        "@type": "SearchAction",
        "target": SITE_URL + "/database?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": SITE_NAME,
      "alternateName": "SWUTCG.one",
      "url": SITE_URL + "/",
      "logo": SITE_URL + "/favicon.svg",
      "description": "Star Wars Unlimited database with card search, deck builder, tournament decklists, and rules walkthrough."
    })} />

    <!-- Per-page <head> additions (e.g. LCP image preload) -->
    <slot name="head" />

    <!-- Client-side routing with smooth page transitions -->
    <ClientRouter />

    <!-- View Transition Animations â€” mirrors optcg's setup so the nav
         stays mounted across navigations and the body cross-fades. -->
    <style is:global>
      @view-transition {
        navigation: auto;
      }

      /* Cross-fade for page body */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 0.2s;
        animation-timing-function: ease-in-out;
      }
      ::view-transition-old(root) { animation-name: fade-out; }
      ::view-transition-new(root) { animation-name: fade-in; }

      @keyframes fade-out { to   { opacity: 0; } }
      @keyframes fade-in  { from { opacity: 0; } }

      /* Slide for forward navigation when explicitly named on a link */
      @media (prefers-reduced-motion: no-preference) {
        ::view-transition-old(slide-forward):only-child {
          animation: slide-out-left 0.25s ease-in-out;
        }
        ::view-transition-new(slide-forward):only-child {
          animation: slide-in-right 0.25s ease-in-out;
        }
        @keyframes slide-out-left {
          to { transform: translateX(-30px); opacity: 0; }
        }
        @keyframes slide-in-right {
          from { transform: translateX(30px); opacity: 0; }
        }
      }

      /* Persistent nav â€” Navigation.astro carries transition:persist="nav".
         This rule freezes its animation duration so it doesn't cross-fade
         along with the body, giving a true SPA feel. */
      ::view-transition-group(nav) {
        animation-duration: 0s;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body class="gallery-mode" data-page={pageId}>
    <div class="page-bg" aria-hidden="true"></div>
    <div class="container">
      <slot />
    </div>

    <script is:inline>
      // Subtle parallax for .page-bg â€” disabled on mobile and reduced-motion.
      // Guarded with __swuParallaxBound so we don't double-bind the scroll
      // listener when ClientRouter re-runs this inline script on each navigation.
      (function() {
        if (window.__swuParallaxBound) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (window.matchMedia('(max-width: 767px)').matches) return;

        const SPEED = 0.15;
        const MAX_OFFSET = window.innerHeight * 0.2;
        let ticking = false;

        function update() {
          const bg = document.querySelector('.page-bg');
          if (!bg) return;
          const raw = window.scrollY * -SPEED;
          const clamped = Math.max(-MAX_OFFSET, raw);
          bg.style.transform = 'translate3d(0,' + clamped + 'px,0)';
          ticking = false;
        }
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }, { passive: true });
        window.__swuParallaxBound = true;
      })();

      // Register the service worker for offline support + cache-first
      // card images. Guarded so the registration runs once per session.
      if ('serviceWorker' in navigator && !window.__swuSWBound) {
        window.__swuSWBound = true;
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>

    <footer class="site-footer">
      <p class="footer-credit">
        Star Wars Unlimited&trade; and all related marks are trademarks of
        <a href="https://www.starwarsunlimited.com/en/" target="_blank" rel="noopener">Fantasy Flight Games Co., Ltd</a>.
        This site is unofficial and not affiliated with or endorsed by Fantasy Flight Games.
        &copy; {new Date().getFullYear()} swutcg.one.
      </p>
    </footer>
  </body>
</html>
